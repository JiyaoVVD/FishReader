{
	"name": "fishreader",
	"displayName": "FishReader",
	"description": "A novel reader.",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"*",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"configuration": {
			"title": "FishReader",
			"properties": {
				"fishreader.defaultBookPath": {
					"type": "string",
					"default": "",
					"description": "小说文件路径"
				},
				"fishreader.hideWhenInput": {
					"type": "boolean",
					"default": true,
					"description": "输入时隐藏状态栏内容"
				},
				"fishreader.hideWhenFocusOut": {
					"type": "boolean",
					"default": true,
					"description": "切换窗口时隐藏状态栏内容"
				},
				"fishreader.hideWhenSwitchEditor": {
					"type": "boolean",
					"default": true,
					"description": "切换文件时隐藏状态栏内容"
				},
				"fishreader.showLength": {
					"type": "integer",
					"default": 20,
					"description": "状态栏显示内容的长度"
				},
				"fishreader.writer.previewLength": {
					"type": "integer",
					"default": 20,
					"minimum": 0,
					"maximum": 200,
					"description": "隐秘码字时在状态栏显示的最近真实字符数；设为 0 可关闭真实文本预览"
				},
				"fishreader.writer.previewTimeout": {
					"type": "integer",
					"default": 3000,
					"minimum": 0,
					"description": "最近真实文本预览自动消失的毫秒数"
				},
				"fishreader.writer.autosaveDebounce": {
					"type": "integer",
					"default": 400,
					"minimum": 100,
					"maximum": 10000,
					"description": "草稿停止输入后自动保存的等待毫秒数"
				},
				"fishreader.writer.hideWhenFocusOut": {
					"type": "boolean",
					"default": true,
					"description": "码字界面或 VS Code 失去焦点时立即隐藏界面和状态栏预览，并强制保存"
				}
			}
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "fishreader",
					"title": "FishReader",
					"icon": "resources/fishreader-icon.svg"
				}
			]
		},
		"views": {
			"fishreader": [
				{
					"id": "bookChapters",
					"name": "目录"
				}
			]
		},
		"commands": [
			{
				"command": "fishreader.refresh",
				"title": "FishReader: Refresh Library"
			},
			{
				"command": "fishreader.openChapter",
				"title": "FishReader: Open Chapter"
			},
			{
				"command": "fishreader.selectChapter",
				"title": "FishReader: Select Chapter"
			},
			{
				"command": "fishreader.openBook",
				"title": "FishReader: Open Book"
			},
			{
				"command": "fishreader.nextLine",
				"title": "FishReader: Next Line"
			},
			{
				"command": "fishreader.prevLine",
				"title": "FishReader: Previous Line"
			},
			{
				"command": "fishreader.nextChapter",
				"title": "FishReader: Next Chapter"
			},
			{
				"command": "fishreader.prevChapter",
				"title": "FishReader: Previous Chapter"
			},
			{
				"command": "fishreader.showContent",
				"title": "FishReader: Show Content"
			},
			{
				"command": "fishreader.hideContent",
				"title": "FishReader: Hide Content"
			},
			{
				"command": "fishreader.startWriting",
				"title": "FishReader: Start Inline Capture"
			},
			{
				"command": "fishreader.startInlineCommentWriting",
				"title": "FishReader: Start Inline Comment Writing"
			},
			{
				"command": "fishreader.startWebviewWriting",
				"title": "FishReader: Start Hidden Webview Writing"
			},
			{
				"command": "fishreader.resumeWriting",
				"title": "FishReader: Resume Writing"
			},
			{
				"command": "fishreader.exitWriting",
				"title": "FishReader: Exit Writing Mode"
			},
			{
				"command": "fishreader.emergencyHideWriting",
				"title": "FishReader: Emergency Hide Writing"
			},
			{
				"command": "fishreader.newDraft",
				"title": "FishReader: New Draft"
			},
			{
				"command": "fishreader.selectDraft",
				"title": "FishReader: Select Draft"
			},
			{
				"command": "fishreader.renameDraft",
				"title": "FishReader: Rename Current Draft"
			},
			{
				"command": "fishreader.exportDraft",
				"title": "FishReader: Export Current Draft"
			},
			{
				"command": "fishreader.submitInlineWriting",
				"title": "FishReader: Submit Inline Draft",
				"shortTitle": "Submit Draft",
				"enablement": "!commentIsEmpty"
			}
		],
		"keybindings": [
			{
				"command": "fishreader.nextLine",
				"key": "alt+k",
				"when": "!fishreader.writingSurfaceFocused"
			},
			{
				"command": "fishreader.prevLine",
				"key": "alt+i",
				"when": "!fishreader.writingSurfaceFocused"
			},
			{
				"command": "fishreader.nextChapter",
				"key": "alt+l",
				"when": "!fishreader.writingSurfaceFocused"
			},
			{
				"command": "fishreader.prevChapter",
				"key": "alt+j",
				"when": "!fishreader.writingSurfaceFocused"
			},
			{
				"command": "fishreader.showContent",
				"key": "alt+;"
			},
			{
				"command": "fishreader.hideContent",
				"key": "alt+'"
			},
			{
				"command": "fishreader.inlineBackspace",
				"key": "backspace",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineBackspace",
				"key": "ctrl+backspace",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineDelete",
				"key": "delete",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineDelete",
				"key": "ctrl+delete",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineSubmit",
				"key": "enter",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlinePaste",
				"key": "ctrl+v",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlinePaste",
				"key": "shift+insert",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.emergencyHideWriting",
				"key": "escape",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+x",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "shift+delete",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+z",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+y",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+shift+z",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "tab",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "shift+tab",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+enter",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "ctrl+shift+enter",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "alt+up",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "alt+down",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "shift+alt+up",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			},
			{
				"command": "fishreader.inlineNoop",
				"key": "shift+alt+down",
				"when": "fishreader.inlineCaptureActive && editorTextFocus"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "fishreader.submitInlineWriting",
					"when": "false"
				}
			],
			"comments/commentThread/context": [
				{
					"command": "fishreader.submitInlineWriting",
					"group": "inline",
					"when": "commentController == fishreader-inline-writing && commentThread == fishreader-inline-draft"
				}
			],
			"view/title": [
				{
					"command": "fishreader.refresh",
					"when": "view == bookChapters",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/mocha": "^10.0.10",
		"@types/node": "22.x",
		"@types/vscode": "^1.100.0",
		"@vscode/test-cli": "^0.0.12",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^9.39.1",
		"ts-loader": "^9.5.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.48.1",
		"webpack": "^5.103.0",
		"webpack-cli": "^6.0.1"
	},
	"dependencies": {
		"iconv-lite": "^0.6.3",
		"jschardet": "^3.1.4"
	}
}
